# Token from @BotFather after /newbot
BOT_TOKEN=

# Optional: chat id for local animation seeding (npm run seed:gifs)
# UPLOAD_CHAT_ID=

# Production webhook (Vercel). Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# Optional: set once after deploy (or pass URL to npm run set-webhook)
# WEBHOOK_URL=https://your-app.vercel.app

# Optional CDN overrides (defaults = animations-v4 on jsDelivr)
# ANIMATIONS_CDN_ROOT=https://cdn.jsdelivr.net/gh/ruslanobel/kanji-master-telegram-bot@animations-v4
# ANIMATIONS_CDN_BASE=https://cdn.jsdelivr.net/gh/ruslanobel/kanji-master-telegram-bot@animations-v4/mp4
# ANIMATIONS_PREVIEW_BASE=https://cdn.jsdelivr.net/gh/ruslanobel/kanji-master-telegram-bot@animations-v4/preview
